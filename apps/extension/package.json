{
  "name": "apps-extension",
  "displayName": "Inspira",
  "version": "0.1.0",
  "description": "把网页、图片和选中文字保存到 Inspira 的 Chrome 扩展",
  "author": "Malus",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.81",
    "@inspira/contracts": "workspace:*",
    "convex": "^1.45.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^5.0.0"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "contextMenus",
      "scripting",
      "storage",
      "cookies"
    ],
    "host_permissions": [
      "$PLASMO_PUBLIC_CLERK_SYNC_HOST/*",
      "$CLERK_FRONTEND_API/*"
    ],
    "key": ""
  }
}
